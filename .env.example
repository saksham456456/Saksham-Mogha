# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy this file to .env.local for local development. Never commit real keys.
# ==============================================================================

# Site canonical URL (e.g. https://saksham-mogha.vercel.app or custom domain)
NEXT_PUBLIC_SITE_URL="https://saksham-mogha.vercel.app"

# Resend API key for secure contact form dispatch (keys never exposed to browser)
RESEND_API_KEY=""

# Recipient email address for inquiries (kept strictly server-side)
CONTACT_TO_EMAIL=""

# Verified sender address on Resend (e.g. "Website <contact@yourdomain.com>")
CONTACT_FROM_EMAIL=""

# Upstash Redis / Vercel KV for edge rate limiting (contact form brute force prevention)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile anti-bot verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Secret token to protect the /api/sync endpoint from unauthorized triggers
CRON_SECRET=""

# Content-Security-Policy rollout mode ("enforce" or "report-only")
CSP_MODE="enforce"
